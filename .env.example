# Copy to .env for local development. Never commit real secrets.

# Key that signs session cookies: at least 16 random characters, e.g. `openssl rand -base64 32`.
# Required in production (the server refuses to start without it). In development an empty
# value falls back to a demo-only key.
SESSION_SECRET=

# Public origin of the deployed site (canonical and hreflang URLs). No trailing slash.
# Read at build time. Defaults to http://localhost:5173.
SITE_URL=

# Share of page loads (0 to 1) that report web vitals to /api/vitals. Read at build time.
# Defaults to 0.1. Development always samples every load; errors are always reported.
RUM_SAMPLE_RATE=
